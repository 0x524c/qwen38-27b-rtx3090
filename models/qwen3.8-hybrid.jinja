        {%- else %}
            {%- set ns2.last_tool = '' %}
            {%- set ns2.tool_ids = '' %}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == 'tool' %}
        {%- set _tr = render_content(message.content, false, false) %}
        {%- set _rt = content | trim %}
        {%- set _result_tool = ns2.last_tool %}
