                        {%- set ns3.sig = ns3.sig ~ '|' ~ _tn ~ ':' ~ (_tcf.arguments | tojson) %}
                    {%- else %}
                        {%- set ns3.sig = ns3.sig ~ '|' ~ _tn ~ ':' ~ (_tcf.arguments | string) %}
                    {%- endif %}
                {%- else %}
                    {%- set ns3.sig = ns3.sig ~ '|' ~ _tn ~ ':' %}
                {%- endif %}
            {%- endfor %}
            {%- set ns2.last_tool = ns3.first %}
            {%- set ns2.tool_ids = ns3.ids %}
            {%- if ns3.sig and (ns3.sig == ns2.sig1 or ns3.sig == ns2.sig2) %}
                {%- set ns2.sig_repeat = ns2.sig_repeat + 1 %}
            {%- else %}
                {%- set ns2.sig_repeat = 0 %}
            {%- endif %}
            {%- set ns2.sig2 = ns2.sig1 %}
            {%- set ns2.sig1 = ns3.sig %}
            {%- for tool_call in message.tool_calls %}
                {%- if tool_call.function is defined and tool_call.function is not none %}
                    {%- set tc = tool_call.function %}
                {%- else %}
                    {%- set tc = tool_call %}
                {%- endif %}
                {%- if _tool_format == 'json' %}
                    {%- if not loop.first or content | trim %}
                        {{- '\n\n' }}
                    {%- endif %}
