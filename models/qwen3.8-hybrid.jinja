        {%- elif ns2.consecutive_failures >= 2 %}
            {{- '\n\n⚠️ SYSTEM WARNING: ' ~ ns2.consecutive_failures ~ ' consecutive tool errors. The latest error differs from the previous one - if each fix is resolving one cause and exposing the next, you are making progress; continue. If the errors look unrelated, step back and diagnose the root cause before the next attempt.' }}
        {%- elif ns2.consecutive_failures == 1 and _powershell_null %}
