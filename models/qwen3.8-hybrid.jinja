            {%- endif %}
        {%- endif %}
        {%- if _result_tool and (_result_tool | lower) == 'skill' and '<skill_content name="' in _tr %}
            {%- set _loaded_name = (_tr.split('<skill_content name="')[-1].split('"')[0]) | trim %}
            {%- set _loaded_token = '|' ~ (_loaded_name | lower) ~ '|' %}
            {%- if _loaded_name and _loaded_token not in ns2.loaded_skills %}
                {%- set ns2.loaded_skills = ns2.loaded_skills ~ _loaded_token %}
                {%- set ns2.loaded_skill_list = ns2.loaded_skill_list ~ (', ' if ns2.loaded_skill_list else '') ~ _loaded_name %}
            {%- endif %}
        {%- endif %}
        {%- set _mut = _result_tool and (' ' ~ (_result_tool | lower) ~ ' ') in (' ' ~ (mutating_tools | lower) ~ ' ') %}
        {%- if _rt and (_rt == ns2.prev1 or _rt == ns2.prev2) and not _mut %}
            {%- set ns2.repeat = ns2.repeat + 1 %}
        {%- else %}
            {%- set ns2.repeat = 0 %}
        {%- endif %}
        {%- set _same_as_prev = _rt and _rt == ns2.prev1 %}
        {%- set ns2.prev2 = ns2.prev1 %}
        {%- set ns2.prev1 = _rt %}
        {%- set _content_lower = content | lower %}
        {%- set _content_head = _content_lower[:120] %}
        {%- set _read_tool = _result_tool and (' ' ~ (_result_tool | lower) ~ ' ') in (' ' ~ (read_tools | lower) ~ ' ') %}
        {%- set _is_code_or_grep = ('throw new ' in _content_lower or 'throw error' in _content_lower or 'console.error' in _content_lower or 'logger.error' in _content_lower or 'logging.error' in _content_lower or 'import ' in _content_head or 'def ' in _content_head or 'function ' in _content_head) %}
        {%- set _exit_code_zero = ('exit code: 0' in _content_head or 'process exited with code 0' in _content_head) %}
        {%- set _error_field_ok = ('"error": null' in _content_head or '"error":null' in _content_head or '"error": false' in _content_head or '"error":false' in _content_head or '"error": ""' in _content_head or '"error":""' in _content_head) %}
        {%- set _powershell_null = _content_head.startswith('you cannot call a method on a null-valued expression.') %}
        {%- set _harness_err = 'invalid input for tool' in _content_head or 'json parsing failed' in _content_head or 'unknown tool' in _content_head or 'error repairing' in _content_head or 'tool execution failed' in _content_head or _content_head.startswith('script execution failed:') or _content_head.startswith('mcp error ') or _content_head.startswith('statuscode: non 2xx status code') or _powershell_null %}
        {%- set _strong_err = (not _read_tool) and (('"error":' in _content_head and not _error_field_ok) or '"status": "error"' in _content_head or '"status":"error"' in _content_head or 'traceback (most recent call last):' in _content_head or 'command not found' in _content_head or 'invalid syntax' in _content_head or (('exit code: ' in _content_head or 'process exited with code' in _content_head) and not _exit_code_zero) or _content_head.startswith('traceback') or _content_head.startswith('error:') or _content_head.startswith('err:') or _content_head.startswith('fatal:') or _content_head.startswith('exception:') or _content_head.startswith('failed to ')) %}
        {%- set _weak_err = (not _read_tool) and ('error:' in _content_head or 'err:' in _content_head or 'err!' in _content_head or 'fatal:' in _content_head or 'exception:' in _content_head or 'traceback' in _content_head or 'failed to' in _content_head) %}
        {%- set _weak_suppressed = (_is_code_or_grep or '$ ' in _content_head or 'took ' in _content_head or content | length >= 600) %}
