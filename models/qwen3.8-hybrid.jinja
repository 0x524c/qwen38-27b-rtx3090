                {{- '<|im_end|>\n' }}
            {%- endif %}
        {%- endif %}
    {%- else %}
        {{- '<|im_start|>user\n[' + message.role + ']: ' + content + '<|im_end|>\n' }}
    {%- endif %}
    {%- set ns2.prev_role = message.role %}
{%- endfor %}
{%- if warn_vanished_tools and _has_tools %}
    {%- set ns_vt = namespace(avail=' ', gone_names=' ', gone_list='') %}
