__pycache__/
api_key.txt
bench/quality-data/
bench/results/
models/
profiles/
qwen.log
venv/
drafter/data/
drafter/runs/
.env
# The profile generator keeps a backup next to the file it rewrites, and that
# backup carries the API key with it. `.env` alone does not match it.
.env.*
# local reproduction artifacts (symlinks here, so no trailing slash)
venv
# models/ holds the 22 GB checkpoint and the 1.2 GB drafter, both fetched by prepare/,
# plus the agentic chat template, which is authored here and has to be tracked --
# the fast profile passes it as --chat-template and cannot boot without it. Excluding
# the directory entry by entry keeps that one file visible to git; the checkpoint
# directories stay ignored because each top-level entry is excluded and never walked.
models/*
!models/*.jinja
api_key.txt
bench/results/
